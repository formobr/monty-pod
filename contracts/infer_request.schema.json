{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monty-pod/contracts/infer_request.schema.json",
  "title": "InferRequest — planner→pod inference task (CP-mediated; the pod polls, nothing dials in)",
  "description": "One BATCHED call per kind, never per-segment. align: the pod runs a pure wav2vec2 forward over the given windows and PUTs the emission log-softmax matrices (npz, layout in README) — post-processing stays on the planner, no text crosses. face_probe: the pod runs YuNet over sampled frames of the given shots and PUTs raw boxes (+frame_diff) as JSON (face_probe.schema.json) — decisions stay on the planner. clip_rank: the pod runs both SigLIP towers over many (intent, images) groups and PUTs cosines + L2-normalized image embeddings as JSON (clip_rank.schema.json) — the reorder, the relevance floor and the MMR dedup stay on the planner, so no threshold appears here by construction. person_matte: the pod runs RVM (mobilenetv3, fp16 TorchScript baked in the image) over ONE whole video and PUTs the requested outputs to their own presigned URLs (alpha: lossless gray FFV1 Matroska; cutout: the input's pixels under the alpha as VP9-alpha yuva420p WebM) plus a receipt JSON (person_matte.schema.json) to put_url; the downsample_ratio is resolved by the planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infer_version",
    "job_id",
    "kind",
    "model",
    "put_url"
  ],
  "properties": {
    "infer_version": {
      "const": 7
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "align",
        "face_probe",
        "clip_rank",
        "person_matte"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "put_url": {
      "type": "string",
      "minLength": 1
    },
    "weights": {
      "description": "Where the pod gets this job's checkpoint — NOTHING heavy is baked into the image. A presigned GET for a tar of the model directory, plus that tar's sha256, which is BOTH the integrity check and the pod's cache key (so a revised checkpoint can never be served from a stale cache entry). REQUIRED for align and clip_rank; forbidden on face_probe and person_matte, whose YuNet (227 KB) and RVM (7.9 MB) stay in the image.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "Expected tar size in bytes; a mismatch fails the fetch.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "align": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_url",
        "windows"
      ],
      "properties": {
        "audio_url": {
          "type": "string",
          "minLength": 1
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "keep_ids": {
          "description": "OPTIONAL column projection for the returned emissions: the sorted, de-duplicated set of vocab indices the caller's CTC forced alignment will read (its target ids plus blank). Present → the pod PUTs emissions_<i> with exactly these columns, in this order, and echoes keep_ids in the npz meta; absent → the full vocab width, byte-identical to before. It is an ALPHABET, not text: no word, no order and no count crosses with it, and nothing here decides anything — the alignment itself stays on the planner.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "face_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_url",
        "shots",
        "stride",
        "frame_diff"
      ],
      "properties": {
        "video_url": {
          "type": "string",
          "minLength": 1
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "stride": {
          "type": "integer",
          "minimum": 1
        },
        "frame_diff": {
          "type": "boolean"
        }
      }
    },
    "clip_rank": {
      "description": "MANY groups per call: a montage scores many candidates across many beats, and one round trip per beat would dominate the wall clock. A request is EITHER a rank (>=1 group, no judge_tiles) OR a judge-tiles request (groups == [] and >=1 judge tile); groups stays required.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups"
      ],
      "oneOf": [
        {
          "properties": {
            "groups": {
              "minItems": 1
            }
          },
          "not": {
            "required": [
              "judge_tiles"
            ]
          }
        },
        {
          "properties": {
            "groups": {
              "maxItems": 0
            }
          },
          "required": [
            "judge_tiles"
          ]
        }
      ],
      "properties": {
        "judge_tiles": {
          "description": "Judge tiles to make: per pair the pod fetches the stock-provider ORIGIN url and PUTs one small JPEG of it to the presigned put_url (the judge keeps PER-TILE images — one object per tile, never a sheet). Only with groups == [].",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin_url",
              "put_url"
            ],
            "properties": {
              "origin_url": {
                "type": "string",
                "minLength": 1
              },
              "put_url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent"
            ],
            "oneOf": [
              {
                "required": [
                  "image_urls"
                ],
                "not": {
                  "required": [
                    "origin_urls"
                  ]
                }
              },
              {
                "required": [
                  "origin_urls"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "image_urls"
                      ]
                    },
                    {
                      "required": [
                        "image_cells"
                      ]
                    }
                  ]
                }
              }
            ],
            "properties": {
              "intent": {
                "description": "The English meaning to score against. \"\" = embed-only: the image tower is text-independent, so the group still yields embeddings and its scores come back as -1.0.",
                "type": "string"
              },
              "image_urls": {
                "description": "Presigned GETs, fetched under the presigned-only rule. A group carries exactly one of image_urls or origin_urls.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "origin_urls": {
                "description": "Stock-provider ORIGIN thumbnail URLs the pod fetches itself (MISC-333). A group carries exactly one of image_urls or origin_urls; image_cells are not allowed with origin_urls.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "image_cells": {
                "description": "Optional crop per image_urls item: [x,y,width,height,sheet_width,sheet_height]. Only with image_urls.",
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 6,
                      "maxItems": 6,
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 1
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "person_matte": {
      "description": "ONE video, whole: RVM is recurrent, so its state runs frame to frame from the first frame (reset per request). At least one output URL.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_url",
        "downsample_ratio"
      ],
      "anyOf": [
        {
          "required": [
            "alpha_put_url"
          ]
        },
        {
          "required": [
            "cutout_put_url"
          ]
        }
      ],
      "properties": {
        "video_url": {
          "type": "string",
          "minLength": 1
        },
        "downsample_ratio": {
          "description": "RVM's first-stage resize, resolved by the planner (480 / longest side above 512 px, else 1).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "alpha_put_url": {
          "description": "FINAL tier: PUT target of the alpha, gray FFV1 Matroska, frame-for-frame with the input.",
          "type": "string",
          "minLength": 1
        },
        "cutout_put_url": {
          "description": "PREVIEW tier: PUT target of the input's pixels under the alpha, VP9-alpha (yuva420p) WebM, no audio.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "align"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "align",
          "weights"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "face_probe"
              ]
            },
            {
              "required": [
                "clip_rank"
              ]
            },
            {
              "required": [
                "person_matte"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "face_probe"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "face_probe"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "align"
              ]
            },
            {
              "required": [
                "clip_rank"
              ]
            },
            {
              "required": [
                "person_matte"
              ]
            },
            {
              "required": [
                "weights"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clip_rank"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "clip_rank",
          "weights"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "align"
              ]
            },
            {
              "required": [
                "face_probe"
              ]
            },
            {
              "required": [
                "person_matte"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "person_matte"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "person_matte"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "align"
              ]
            },
            {
              "required": [
                "face_probe"
              ]
            },
            {
              "required": [
                "clip_rank"
              ]
            },
            {
              "required": [
                "weights"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "span": {
      "description": "[start, end] seconds, source time, end > start (model-enforced).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
