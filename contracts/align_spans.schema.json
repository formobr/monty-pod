{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monty-pod/contracts/align_spans.schema.json",
  "title": "align spans — the pod's answer to an align request that carries targets",
  "description": "One span per target index, in order: [start_frame, end_frame, score], end exclusive, score = mean log-prob of the frames (torchaudio merge_tokens). spans is null exactly when overflow is true (len(targets) + count of equal adjacent targets > frames; no DP ran). Frames, not words or seconds: seconds = frame * frame_stride_s is the planner's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "sr", "frame_stride_s", "frames", "vocab_sha256", "overflow", "spans"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "sr": { "const": 16000 },
    "frame_stride_s": { "const": 0.02 },
    "frames": { "type": "integer", "minimum": 0 },
    "vocab_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "overflow": { "type": "boolean" },
    "spans": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "type": "integer", "minimum": 0 },
              { "type": "integer", "minimum": 1 },
              { "type": "number" }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "overflow": { "const": true } } }, "then": { "properties": { "spans": { "type": "null" } } }, "else": { "properties": { "spans": { "type": "array" } } } }
  ]
}
