      "description": "Strict pod->control-plane frame on the sole pod transport. Every frame carries a pod-monotonic send stamp; terminal frames echo the atomic claim attempt.",
      "oneOf": [
        {
          "$ref": "#/$defs/eventFrame"
        },
        {
          "$ref": "#/$defs/resultFrame"
        },
        {
          "$ref": "#/$defs/jobAckFrame"
        }
      ],
      "title": "PodStreamClientFrame",
      "x-contract-version": 14
    },
    "pod_stream_server": {
      "$defs": {
        "ackFrame": {
          "additionalProperties": false,
          "properties": {
            "duplicate": {
              "type": "boolean"
            },
            "error": {
              "type": "string"
            },
            "seq": {
              "minimum": 1,
              "type": "integer"
            },
            "server_recv_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "server_send_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "status": {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            "stream_id": {
              "$ref": "#/$defs/streamId"
            },
            "type": {
              "const": "ack"
            }
          },
          "required": [
            "type",
            "stream_id",
            "seq",
            "status",
            "server_recv_unix_ns",
            "server_send_unix_ns"
          ],
          "type": "object"
        },
        "attemptId": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "jobFrame": {
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "$ref": "#/$defs/attemptId"
            },
            "delivery_id": {
              "minLength": 1,
              "type": "string"
            },
            "job": {
              "$ref": "#/$defs/podJob"
            },
            "replayed": {
              "type": "boolean"
            },
            "seq": {
              "minimum": 1,
              "type": "integer"
            },
            "stream_id": {
              "$ref": "#/$defs/streamId"
            },
            "timeline": {
              "$ref": "#/$defs/jobTimeline"
            },
            "type": {
              "const": "job"
            }
          },
          "required": [
            "type",
            "delivery_id",
            "attempt_id",
            "stream_id",
            "seq",
            "replayed",
            "timeline",
            "job"
          ],
          "type": "object"
        },
        "jobTimeline": {
          "additionalProperties": false,
          "properties": {
            "claim_max_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "claim_min_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "enqueue_max_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "enqueue_min_unix_ns": {
              "$ref": "#/$defs/unixNs"
            },
            "socket_write_min_unix_ns": {
              "$ref": "#/$defs/unixNs"
            }
          },
          "required": [
            "enqueue_min_unix_ns",
            "enqueue_max_unix_ns",
            "claim_min_unix_ns",
            "claim_max_unix_ns",
            "socket_write_min_unix_ns"
          ],
          "type": "object"
        },
        "podJob": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "infer"
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "spec"
                      ]
                    },
                    {
                      "required": [
                        "chain"
                      ]
                    }
                  ]
                },
                "required": [
                  "request"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "render"
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "request"
                      ]
                    },
                    {
                      "required": [
                        "chain"
                      ]
                    }
                  ]
                },
                "required": [
                  "spec"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "ops"
                  }
                }
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "request"
                      ]
                    },
                    {
                      "required": [
                        "spec"
                      ]
                    }
                  ]
                },
                "required": [
                  "chain"
                ]
              }
            }
          ],
          "properties": {
            "chain": {
              "type": "object"
            },
            "corr_id": {
              "minLength": 1,
              "type": "string"
            },
            "request": {
              "type": "object"
            },
            "session_id": {
              "minLength": 1,
              "type": "string"
            },
            "spec": {
              "type": "object"
            },
            "target_worker_id": {
              "description": "Control-plane-only warm-up routing fence. The API strips it before the WebSocket payload; a fleet worker may claim the stored envelope only when its identity matches.",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            "type": {
              "enum": [
                "infer",
                "render",
                "ops"
              ]
            }
          },
          "required": [
            "type",
            "session_id",
            "corr_id"
          ],
          "type": "object"
        },
        "streamId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "unixNs": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "$id": "https://monty.fast/contracts/pod_stream_server.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Strict control-plane->pod frame on the sole pod transport.",
      "oneOf": [
        {
          "$ref": "#/$defs/ackFrame"
        },
        {
          "$ref": "#/$defs/jobFrame"
        }
      ],
      "title": "PodStreamServerFrame",
      "x-contract-version": 14
    }
  },
